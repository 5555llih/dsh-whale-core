{
  "name": "dsh-whale-core",
  "version": "0.6.24",
  "description": "DSH 专用身份内核：可编辑人设 + 记忆 + 心情衰减 + 设置面板（零依赖，不含 QQ 通道）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "license": "MIT"
}
